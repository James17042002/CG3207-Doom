# --- IP Core Generated Files ---
# Ignore everything generated by IP cores except the core configuration itself (.xci)
**/*.srcs/sources_1/ip/*/*
!**/*.srcs/sources_1/ip/*/*.xci

# --- Block Design Generated Files ---
# Ignore everything generated by Block Designs except the wrapper and diagram (.bd)
**/*.srcs/sources_1/bd/*/*
!**/*.srcs/sources_1/bd/*/*.bd
!**/*.srcs/sources_1/bd/*/hdl/

